package main

import (
	"fmt"
	"sync"
	"time"
)

type Job struct {
	ID    int
	Input int
}

type Result struct {
	JobID    int
	WorkerID int
	Output   int
}

func worker(ID int, jobs <-chan Job, results chan<- Result, wg *sync.WaitGroup) {
	defer wg.Done()
	for job := range jobs {
		time.Sleep(200 * time.Millisecond)
		results <- Result{
			JobID:    job.ID,
			WorkerID: ID,
			Output:   job.Input * 2,
		}
	}
}

func main() {
	const numOfWorkers = 3
	const numOfJobs = 10

	jobs := make(chan Job, numOfJobs)
	results := make(chan Result, numOfJobs)

	var wg sync.WaitGroup

	// start workers
	for w := 1; w <= numOfWorkers; w++ {
		wg.Add(1)
		go worker(w, jobs, results, &wg)
	}

	//submit the jobs
	for j := 1; j <= numOfJobs; j++ {
		jobs <- Job{
			ID:    j,
			Input: j * 10,
		}
	}

	close(jobs)
	go func() {
		wg.Wait()
		close(results)
	}()

	for res := range results {
		fmt.Printf("Worker: %d Job ID: %d Result: %d\n", res.WorkerID, res.JobID, res.Output)
	}

}
